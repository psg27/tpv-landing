---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo_claro.png';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-background-main/80 backdrop-blur-lg border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-28">
      
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="#" class="flex items-center gap-2 group">
          <Image src={logoImage} alt="POS EXPRESS Logo" class="h-20 md:h-24 w-auto transition-transform group-hover:scale-105" />
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-8">
        <a href="#caracteristicas" class="text-sm font-medium text-secondary/70 hover:text-primary transition-colors">Características</a>
        <a href="#como-funciona" class="text-sm font-medium text-secondary/70 hover:text-primary transition-colors">Cómo funciona</a>
        <a href="#precios" class="text-sm font-medium text-secondary/70 hover:text-primary transition-colors">Precios</a>
        <a href="#faq" class="text-sm font-medium text-secondary/70 hover:text-primary transition-colors">FAQ</a>
      </nav>

      <!-- CTA Button -->
      <div class="hidden md:flex items-center">
        <a href="#precios" class="bg-primary hover:bg-primary/90 text-white px-6 py-2.5 rounded-full font-semibold text-sm transition-all duration-200 transform hover:scale-105 shadow-lg shadow-primary/30">
          Probar demo
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button type="button" class="text-secondary hover:text-primary focus:outline-none" aria-label="Menu">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>
</header>
