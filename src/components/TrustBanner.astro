---
// TrustBanner.astro — Social proof & free trial banner
const stats = [
  {
    icon: "shield",
    value: "+20",
    unit: "Años",
    label: "de experiencia nos respaldan",
  },
  {
    icon: "gift",
    value: "1 Mes",
    unit: "",
    label: "de prueba gratis para nuevos clientes",
  }
];
---

<section id="confianza" class="relative py-20 overflow-hidden">
  <!-- Background glow -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-primary/10 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Top badge -->
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 mb-6">
        <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span class="text-primary font-semibold text-sm">Empresa con trayectoria comprobada</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-secondary leading-tight mb-4">
        Más de <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-orange-400">20 años de experiencia</span> nos respaldan
      </h2>
      <p class="text-lg text-secondary/60 max-w-2xl mx-auto">
        Dos décadas creando soluciones de punto de venta para negocios como el tuyo. Conocemos tu industria y sabemos lo que necesitas.
      </p>
    </div>

    <!-- Stats grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-14 max-w-2xl mx-auto">

      <!-- Stat 1: 20 Years -->
      <div class="trust-card group">
        <div class="trust-icon-wrapper">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div class="trust-value">+20</div>
        <div class="trust-unit">Años</div>
        <div class="trust-label">de experiencia nos respaldan</div>
      </div>

      <!-- Stat 2: Free Trial -->
      <div class="trust-card group trust-card--highlight">
        <div class="trust-icon-wrapper trust-icon--highlight">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
          </svg>
        </div>
        <div class="trust-value trust-value--highlight">1 Mes</div>
        <div class="trust-unit">Gratis</div>
        <div class="trust-label">de prueba para clientes nuevos</div>
        <div class="absolute -top-3 -right-3 px-2.5 py-1 bg-primary text-white text-[10px] font-bold uppercase rounded-full tracking-wider shadow-lg shadow-primary/30 animate-pulse">
          ¡Nuevo!
        </div>
      </div>

    </div>

    <!-- Free Trial CTA Banner -->
    <div class="trial-banner">
      <div class="trial-banner-glow"></div>
      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-5">
          <div class="w-16 h-16 rounded-2xl bg-primary/20 flex items-center justify-center flex-shrink-0">
            <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl md:text-2xl font-bold text-secondary mb-1">
              Prueba POS EXPRESS <span class="text-primary">1 mes completamente gratis</span>
            </h3>
            <p class="text-secondary/60 text-sm md:text-base">
              Sin tarjeta de crédito, sin compromisos. Accede a todas las funciones del plan Pro durante 30 días.
            </p>
          </div>
        </div>
        <a href="https://tpv.isotech.mx/tpv-saas/public/login" class="flex-shrink-0 px-8 py-4 bg-primary hover:bg-primary/90 text-white rounded-full font-bold text-base transition-all transform hover:-translate-y-1 shadow-lg shadow-primary/30 whitespace-nowrap">
          Comenzar gratis →
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .trust-card {
    position: relative;
    text-align: center;
    padding: 2rem 1.5rem;
    border-radius: 1.25rem;
    background: rgba(17, 17, 17, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .trust-card:hover {
    border-color: rgba(242, 106, 33, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(242, 106, 33, 0.1);
  }

  .trust-card--highlight {
    border-color: rgba(242, 106, 33, 0.3) !important;
    background: rgba(242, 106, 33, 0.06) !important;
  }

  .trust-card--highlight:hover {
    border-color: rgba(242, 106, 33, 0.5) !important;
    box-shadow: 0 12px 40px rgba(242, 106, 33, 0.2) !important;
  }

  .trust-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1rem;
    transition: all 0.3s ease;
  }

  .trust-card:hover .trust-icon-wrapper {
    background: rgba(242, 106, 33, 0.15);
    color: rgb(242, 106, 33);
  }

  .trust-icon--highlight {
    background: rgba(242, 106, 33, 0.15) !important;
    color: rgb(242, 106, 33) !important;
  }

  .trust-value {
    font-size: 2.5rem;
    font-weight: 900;
    color: #fff;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .trust-value--highlight {
    background: linear-gradient(135deg, rgb(242, 106, 33), rgb(251, 146, 60));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .trust-unit {
    font-size: 0.875rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 0.25rem;
  }

  .trust-label {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 0.5rem;
    line-height: 1.4;
  }

  /* Free trial CTA banner */
  .trial-banner {
    position: relative;
    padding: 2rem 2.5rem;
    border-radius: 1.5rem;
    background: rgba(17, 17, 17, 0.8);
    border: 1px solid rgba(242, 106, 33, 0.2);
    overflow: hidden;
    backdrop-filter: blur(12px);
  }

  .trial-banner-glow {
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    height: 100%;
    background: radial-gradient(ellipse at center right, rgba(242, 106, 33, 0.12), transparent 70%);
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .trust-value {
      font-size: 1.75rem;
    }
    .trust-card {
      padding: 1.25rem 1rem;
    }
    .trial-banner {
      padding: 1.5rem;
      text-align: center;
    }
  }
</style>
