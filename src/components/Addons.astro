---
// Addons.astro — Mejoras e Integraciones
const addons = [
  {
    name: "Soporte y Puesta en Marcha",
    description: "Acompañamiento personalizado para configurar tu sistema desde cero y capacitar a tu equipo.",
    price: "$2,000",
    period: "/mes",
    badge: "Opcional",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`,
    type: "monthly",
  },
  {
    name: "Portal de Facturación de Tickets",
    description: "Permite a tus clientes facturar sus tickets de compra en línea, de forma autónoma.",
    price: "+$250",
    period: "/mes",
    badge: null,
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`,
    type: "monthly",
  },
  {
    name: "App Móvil B2C Clientes",
    description: "App para que tus clientes consulten historial, puntos de lealtad y realicen pedidos.",
    price: "+$250",
    period: "/mes",
    badge: null,
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`,
    type: "monthly",
  },
  {
    name: "Ecommerce WEB",
    description: "Tienda en línea integrada con tu inventario y punto de venta para vender por internet.",
    price: "+$300",
    period: "/mes",
    badge: "Popular",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" /></svg>`,
    type: "monthly",
  },
  {
    name: "Pagos en Línea (Mercado Pago / PayPal)",
    description: "Integración de pasarelas de pago para cobrar en línea directamente desde tu sistema.",
    price: "+$1,800",
    period: "",
    badge: "Pago Único",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>`,
    type: "one-time",
  },
  {
    name: "Tienda Mercado Libre",
    description: "Sincroniza tus productos e inventario con tu tienda de Mercado Libre automáticamente.",
    price: "+$3,000",
    period: "",
    badge: "Pago Único",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>`,
    type: "one-time",
  },
];
---

<section id="integraciones" class="py-24 bg-background-alt/10 border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-primary font-bold tracking-wide uppercase text-sm mb-3">Mejoras e Integraciones</h2>
      <p class="text-3xl md:text-4xl font-black text-secondary leading-tight mb-4">Potencia tu sistema con add-ons</p>
      <p class="text-lg text-secondary/60">Agrega funcionalidades extra a tu plan según las necesidades de tu negocio.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {addons.map((addon) => (
        <div class={`addon-card group ${addon.type === 'one-time' ? 'addon-card--onetime' : ''}`}>

          {/* Badge */}
          {addon.badge && (
            <div class={`absolute top-4 right-4 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider ${
              addon.badge === 'Popular' ? 'bg-primary/20 text-primary' :
              addon.badge === 'Pago Único' ? 'bg-amber-500/15 text-amber-400' :
              'bg-white/10 text-secondary/60'
            }`}>
              {addon.badge}
            </div>
          )}

          {/* Icon */}
          <div class="addon-icon">
            <Fragment set:html={addon.icon} />
          </div>

          {/* Content */}
          <h3 class="text-lg font-bold text-secondary mb-2 pr-16">{addon.name}</h3>
          <p class="text-secondary/50 text-sm leading-relaxed mb-5 flex-grow">{addon.description}</p>

          {/* Price */}
          <div class="flex items-baseline gap-1 pt-4 border-t border-white/5">
            <span class="text-2xl font-black text-secondary">{addon.price}</span>
            {addon.period && (
              <span class="text-secondary/40 font-medium text-sm">{addon.period}</span>
            )}
            {addon.type === 'one-time' && (
              <span class="text-amber-400/70 font-medium text-xs ml-1">pago único</span>
            )}
          </div>
        </div>
      ))}
    </div>

    {/* Note */}
    <p class="text-center text-secondary/40 text-sm mt-10 max-w-2xl mx-auto">
      Todos los add-ons pueden agregarse a cualquier plan. Contacta a nuestro equipo de ventas para personalizar tu solución ideal.
    </p>
  </div>
</section>

<style>
  .addon-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border-radius: 1.25rem;
    background: rgba(17, 17, 17, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .addon-card:hover {
    border-color: rgba(242, 106, 33, 0.25);
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
  }

  .addon-card--onetime {
    border-color: rgba(245, 158, 11, 0.1);
  }

  .addon-card--onetime:hover {
    border-color: rgba(245, 158, 11, 0.3);
    box-shadow: 0 12px 40px rgba(245, 158, 11, 0.08);
  }

  .addon-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 0.75rem;
    background: rgba(242, 106, 33, 0.1);
    color: rgb(242, 106, 33);
    margin-bottom: 1rem;
    transition: all 0.3s ease;
  }

  .addon-card:hover .addon-icon {
    background: rgba(242, 106, 33, 0.2);
    transform: scale(1.08);
  }

  .addon-card--onetime .addon-icon {
    background: rgba(245, 158, 11, 0.1);
    color: rgb(245, 158, 11);
  }

  .addon-card--onetime:hover .addon-icon {
    background: rgba(245, 158, 11, 0.2);
  }
</style>
