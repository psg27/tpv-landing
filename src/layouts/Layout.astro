---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="POS EXPRESS - Controla tu negocio de forma simple y rápida" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Google Fonts: Inter -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-background-main text-secondary font-sans antialiased selection:bg-primary selection:text-white flex flex-col min-h-screen">
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--bg-main: #000000;
		--bg-alt: #111111;
		--secondary: #FFFFFF;
	}
	html {
		font-family: 'Inter', system-ui, sans-serif;
		background-color: var(--bg-main);
		color: var(--secondary);
	}
	body {
		background-color: var(--bg-main) !important;
		background-image: 
			radial-gradient(at 0% 0%, rgba(242, 106, 33, 0.08) 0px, transparent 50%),
			radial-gradient(at 100% 0%, rgba(242, 106, 33, 0.05) 0px, transparent 50%),
			radial-gradient(at 50% 100%, rgba(242, 106, 33, 0.07) 0px, transparent 50%) !important;
		background-attachment: fixed !important;
		color: var(--secondary) !important;
	}
	.text-secondary {
		color: var(--secondary) !important;
	}
	.text-secondary\/80 { color: rgba(255, 255, 255, 0.8) !important; }
	.text-secondary\/70 { color: rgba(255, 255, 255, 0.7) !important; }
	.text-secondary\/60 { color: rgba(255, 255, 255, 0.6) !important; }
	.text-secondary\/50 { color: rgba(255, 255, 255, 0.5) !important; }
	.text-secondary\/40 { color: rgba(255, 255, 255, 0.4) !important; }
</style>
