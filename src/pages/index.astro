---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import TrustBanner from '../components/TrustBanner.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import Addons from '../components/Addons.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout 
	title="POS EXPRESS | Sistema Punto de Venta en la Nube y Facturación CFDI 4.0"
	description="El software punto de venta más completo y fácil de usar en México. Gestiona inventarios, ventas y factura CFDI 4.0 desde cualquier dispositivo. ¡Inicia tu prueba gratis!"
>
	<Header />
	
	<main>
		<Hero />
		<Features />
		<TrustBanner />
		<HowItWorks />
		<Pricing />
		<Addons />
		<FAQ />
	</main>

	<Footer />
	<WhatsAppButton />
</Layout>

